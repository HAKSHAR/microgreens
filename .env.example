# Set your own admin password here
ADMIN_PASSWORD=change-this-password

# Any random long string, used to sign the admin session cookie
ADMIN_SECRET=change-this-to-a-long-random-string

# These are added automatically when you connect Vercel KV and Vercel Blob
# from the Storage tab in your Vercel project — you don't need to set them
# by hand, but they're listed here so you know what to expect.
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# BLOB_READ_WRITE_TOKEN=
